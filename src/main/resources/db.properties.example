# Cau hinh ket noi SQL Server - chinh lai cho dung moi truong cua ban
db.url=jdbc:sqlserver://localhost:1433;databaseName=snapshot01db;encrypt=true;trustServerCertificate=true
db.username=CHANGE_ME
db.password=CHANGE_ME_PASSWORD
db.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver

db.pool.maxSize=10
db.pool.minIdle=2
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
